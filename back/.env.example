MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=tinder_missao
JWT_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin inicial (opcional): criado no startup se não existir
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# Pasta dos uploads locais
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
MIN_PHOTO_PX=400

# Supabase Storage (opcional). Se definido, os uploads vão para o bucket público
# em vez da pasta local. Use a service_role key (somente no backend, nunca no front).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=photos

# CORS: domínio(s) do front em produção, separados por vírgula
CORS_ORIGINS=

# Segurança: validade (em minutos) do link de redefinição de senha gerado pelo admin
RESET_TOKEN_MINUTES=60
