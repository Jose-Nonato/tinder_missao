# Opcional. Por padrão o front chama /api, que o Vite encaminha para o FastAPI.
# VITE_API_URL=http://localhost:8000
# Alvo do proxy no dev (se o back não estiver em 8000):
# API_PROXY_TARGET=http://127.0.0.1:8000

# Doações opcionais. Valores públicos incluídos no build; nunca use segredos aqui.
# Deixe todos vazios para mostrar "Em breve". Pode combinar os meios abaixo.
# Link de pagamento do intermediador, ex.: Asaas. Apenas HTTPS; ação principal.
VITE_DONATION_URL=
VITE_DONATION_PIX_KEY=
# URL HTTPS da imagem ou caminho local em public (ex.: /donation-qr.png).
# Use um QR real e confirme o destinatário antes de publicar. Reconstrua o front após alterar.
VITE_DONATION_QR_URL=
